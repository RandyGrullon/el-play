{
  "expo": {
    "name": "El Play",
    "slug": "el-play",
    "description": "Béisbol dominicano en vivo: LIDOM pitcheo a pitcheo, posiciones, estadísticas y Fantasy.",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elplay",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#2563eb",
    "ios": {
      "bundleIdentifier": "com.grullonb.elplay",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.grullonb.elplay",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "El Play",
      "shortName": "El Play",
      "themeColor": "#0b0c10",
      "backgroundColor": "#0b0c10"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f6f9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0b0c10",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "es",
            "en"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "El Play usa la foto que escojas como fondo de la imagen que vas a compartir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "El Play usa la foto que escojas como fondo de la imagen que vas a compartir.",
          "savePhotosPermission": "El Play guarda en tus fotos la imagen que preparaste para compartir.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563eb",
          "defaultChannel": "juegos",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.grullonb.elplay.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.grullonb.elplay",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

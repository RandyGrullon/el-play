    "glossary": {
      "ab": {
        "term": "VB",
        "name": "Veces al bate",
        "text": "Turnos oficiales: no cuentan bases por bolas, golpeados ni sacrificios."
      },
      "r": {
        "term": "C",
        "name": "Carreras anotadas"
      },
      "h": {
        "term": "H",
        "name": "Hits"
      },
      "rbi": {
        "term": "CI",
        "name": "Carreras impulsadas"
      },
      "bb": {
        "term": "BB",
        "name": "Bases por bolas"
      },
      "k": {
        "term": "K",
        "name": "Ponches"
      },
      "avg": {
        "term": "AVG",
        "name": "Promedio de bateo de la temporada",
        "formula": "AVG = H / VB",
        "text": "En la fila de totales, el promedio del equipo en este juego."
      },
      "d": {
        "term": "2B",
        "name": "Dobles"
      },
      "t": {
        "term": "3B",
        "name": "Triples"
      },
      "sb": {
        "term": "BR",
        "name": "Bases robadas"
      },
      "hbp": {
        "term": "GP",
        "name": "Golpeado por lanzamiento"
      },
      "sf": {
        "term": "ES",
        "name": "Elevados de sacrificio"
      },
      "lob": {
        "term": "LOB",
        "name": "Dejados en base",
        "text": "Por bateador: los corredores que había en base cuando hizo out. Debajo de la tabla, los del equipo al terminar cada entrada."
      },
      "obp": {
        "term": "OBP",
        "name": "Promedio de embasarse de la temporada",
        "formula": "OBP = (H + BB + GP) / (VB + BB + GP + ES)"
      },
      "ops": {
        "term": "OPS",
        "name": "Embasarse más slugging de la temporada",
        "formula": "OPS = OBP + SLG"
      },
      "ip": {
        "term": "IP",
        "name": "Entradas lanzadas",
        "text": "El decimal son outs: 2.1 son 2 entradas y 1 out."
      },
      "er": {
        "term": "CL",
        "name": "Carreras limpias",
        "text": "Las que no llegan por un error ni por una bola pasada."
      },
      "era": {
        "term": "EFE",
        "name": "Efectividad de la temporada",
        "formula": "EFE = CL × 9 / IP"
      },
      "ps": {
        "term": "P-S",
        "name": "Pitcheos y strikes",
        "text": "La barra muestra el porcentaje de strikes."
      },
      "bf": {
        "term": "Enfrentó",
        "name": "Bateadores enfrentados"
      },
      "goao": {
        "term": "Rodados, elevados",
        "name": "Outs por rodado y por elevado"
      },
      "ir": {
        "term": "Heredados",
        "name": "Corredores heredados y anotados",
        "text": "Los que estaban en base cuando entró el relevista; si anotan, la carrera es del lanzador anterior."
      },
      "hold": {
        "term": "Hold",
        "name": "Relevista que mantiene la ventaja",
        "text": "Entra con situación de salvado, la conserva y no termina el juego."
      },
      "risp": {
        "term": "Corr. en posición",
        "name": "Hits con corredores en 2.ª o 3.ª",
        "formula": "H-VB con corredores en posición anotadora"
      }
    }

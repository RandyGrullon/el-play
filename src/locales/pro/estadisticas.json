    "glossary": {
      "formula": {
        "avg": "AVG = H / VB",
        "obp": "OBP = (H + BB + GP) / (VB + BB + GP + ES)",
        "slg": "SLG = bases totales / VB",
        "ops": "OPS = OBP + SLG",
        "opsPlus": "OPS+ = 100 × (OBP / OBP liga + SLG / SLG liga − 1)",
        "iso": "ISO = SLG − AVG",
        "babip": "BABIP = (H − HR) / (VB − K − HR + ES)",
        "kPct": "K% = K / AP",
        "bbPct": "BB% = BB / AP",
        "bbK": "BB/K = BB / K",
        "abHr": "VB/HR = VB / HR",
        "sbPct": "BR% = BR / (BR + AR)",
        "era": "EFE = 9 × CL / IP",
        "eraPlus": "EFE+ = 100 × EFE liga / EFE",
        "whip": "WHIP = (BB + H) / IP",
        "fip": "FIP = (13 × HR + 3 × (BB + GP) − 2 × K) / IP + constante de la liga",
        "k9": "K/9 = 9 × K / IP",
        "bb9": "BB/9 = 9 × BB / IP",
        "h9": "H/9 = 9 × H / IP",
        "hr9": "HR/9 = 9 × HR / IP",
        "kBb": "K/BB = K / BB"
      },
